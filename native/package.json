{
  "name": "radio-melody-native",
  "private": true,
  "version": "1.0.0",
  "description": "Capacitor wrapper that turns the World Radio web app into installable Android and iOS apps (Android Auto / CarPlay groundwork).",
  "scripts": {
    "sync": "npm run build:web && cap sync",
    "build:web": "cd ../frontend && npm run build",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/status-bar": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
